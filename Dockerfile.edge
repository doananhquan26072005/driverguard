# DriverGuard edge agent in a container (M42): blocks 1-14 on a video file, for runs with the CPU
# and memory capped like a small board (tools/edge_sim.py, config/edge_profiles.yaml; PRD FR-14,
# FR-18). The product on the vehicle is the APK, not this image: it exists to get a `simulated`
# number for a weak machine before a hub is chosen.
#
#   docker build -f Dockerfile.edge -t driverguard-edge .
#   python tools/edge_sim.py --profile jetson_nano --duration 10m --source data/clip.mp4
#
# The models are not in the image (YOLOv8n is AGPL, the files are not in the repo): mount ./models
# read-only at /app/models. Videos are mounted read-only too; no frame is ever written.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MPLCONFIGDIR=/tmp \
    HOME=/tmp

# OpenCV and MediaPipe wheels load libGL / glib even headless.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 libgles2 libegl1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
# MediaPipe: the same requirement as requirements.txt for non-macOS. The 0.10.21 the macOS
# development machines are pinned to has no linux/arm64 wheel (checked 05/10/2026: 0.10.18, then
# 1.0.0 and 1.0.1), so on arm64 this installs 1.0.x; the report prints the version it ran with.
RUN pip install --no-cache-dir \
    "opencv-python>=4.9.0" "numpy>=1.26.0" "pyyaml>=6.0" "mediapipe>=0.10.20" \
    "onnxruntime>=1.18.0" "psutil>=5.9"

COPY edge_agent/ edge_agent/
COPY tools/ tools/
COPY config/ config/
RUN mkdir -p /app/data /app/models /out && chmod 777 /app/data /out

ENTRYPOINT ["python"]
CMD ["-m", "edge_agent.main", "--source", "/video/sample.mp4", "--no-window", "--hud-port", "0", \
     "--scenario", "config/scenarios/city_day.yaml"]

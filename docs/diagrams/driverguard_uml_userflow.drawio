" as="geometry" /></mxCell><mxCell id="inc_uc07" value="«include»" style="endArrow=open;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="uc01" target="uc07"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="inc_uc08" value="«include»" style="endArrow=open;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="uc01" target="uc08"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ext_uc02" value="«extend»" style="endArrow=open;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="uc02" target="uc01"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ext_uc03" value="«extend»" style="endArrow=open;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="uc03" target="uc01"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ext_uc04" value="«extend»" style="endArrow=open;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="uc04" target="uc01"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="note1" value="«include» = luôn xảy ra trong luồng  ·  «extend» = chỉ xảy ra khi thoả điều kiện (tuỳ chọn)&lt;br&gt;UC-15 và UC-16 là optional. FR-19 (cá nhân hoá ngưỡng theo tài xế) và FR-20 (fleet + OTA mock)&lt;br&gt;là tính năng lâu dài — không vẽ trong sơ đồ này. Mọi UC trace về PRD DriverGuard v2.2 §4." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#d6b656;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="220" y="1130" width="880" height="95" as="geometry" /></mxCell></root></mxGraphModel>

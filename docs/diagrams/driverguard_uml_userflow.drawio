<diagram id="2." name="2. User Flow - Tai xe">
<mxGraphModel dx="1422" dy="798" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1620" pageHeight="1860" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="start" value="Bắt đầu phiên chạy&lt;br&gt;(replay video mẫu / live webcam) (FR-15)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="460" y="70" width="320" height="70" as="geometry" /></mxCell><mxCell id="b1" value="Trích xuất tín hiệu RGB: mắt, miệng, head pose (FR-4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="460" y="190" width="320" height="80" as="geometry" /></mxCell><mxCell id="d1" value="Có mặt và chất lượng ảnh đủ tốt?&lt;br&gt;(FR-6)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="460" y="310" width="320" height="120" as="geometry" /></mxCell><mxCell id="o1" value="KHÔNG QUAN SÁT ĐƯỢC (xám)&lt;br&gt;— không cảnh báo (FR-6)&lt;br&gt;→ chờ vòng kế tiếp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="880" y="310" width="300" height="90" as="geometry" /></mxCell><mxCell id="b2" value="Làm mượt theo thời gian&lt;br&gt;+ hợp nhất đa tín hiệu (FR-5)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="460" y="480" width="320" height="80" as="geometry" /></mxCell><mxCell id="d2" value="Xe đang chạy? (CAN-sim &amp;gt; 0)&lt;br&gt;(FR-3)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="460" y="610" width="320" height="120" as="geometry" /></mxCell><mxCell id="o2" value="BÌNH THƯỜNG (xe dừng)&lt;br&gt;— không cảnh báo (FR-3)&lt;br&gt;→ chờ vòng kế tiếp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="880" y="610" width="300" height="90" as="geometry" /></mxCell><mxCell id="d3" value="Buồn ngủ kéo dài ≥ ngưỡng&lt;br&gt;(~1,5–2,5s)? (FR-5)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="460" y="780" width="320" height="120" as="geometry" /></mxCell><mxCell id="d4" value="Mất tập trung kéo dài&lt;br&gt;≥ ngưỡng? (FR-5)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="880" y="780" width="300" height="120" as="geometry" /></mxCell><mxCell id="o3" value="BÌNH THƯỜNG&lt;br&gt;— không có dấu hiệu (FR-1)&lt;br&gt;→ chờ vòng kế tiếp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1240" y="780" width="300" height="90" as="geometry" /></mxCell><mxCell id="a1" value="CẢNH BÁO BUỒN NGỦ (đỏ)&lt;br&gt;“Bạn đang có dấu hiệu buồn ngủ.&lt;br&gt;Vui lòng dừng xe.” (FR-1.1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="950" width="320" height="110" as="geometry" /></mxCell><mxCell id="a2" value="CẢNH BÁO MẤT TẬP TRUNG (cam)&lt;br&gt;“Vui lòng tập trung nhìn đường”&lt;br&gt;(FR-1.2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="880" y="950" width="300" height="110" as="geometry" /></mxCell><mxCell id="b3" value="Ghi nhật ký sự kiện: thời gian, trạng thái, dấu hiệu,&lt;br&gt;điều kiện, phiên bản config, tag simulated/true (FR-8)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="460" y="1110" width="320" height="90" as="geometry" /></mxCell><mxCell id="b4" value="Áp dụng cooldown 10s&lt;br&gt;(không hú liên tục) (FR-2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6
ght="80" as="geometry" /></mxCell><mxCell id="uc02" value="UC-02 Cảnh báo buồn ngủ&lt;br&gt;«extend» (FR-1.1)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="270" y="190" width="200" height="80" as="geometry" /></mxCell><mxCell id="uc03" value="UC-03 Cảnh báo mất tập trung&lt;br&gt;«extend» (FR-1.2)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="270" y="290" width="200" height="80" as="geometry" /></mxCell><mxCell id="uc04" value="UC-04 Báo trạng thái unavailable&lt;br&gt;«extend» (FR-6)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="270" y="390" width="200" height="80" as="geometry" /></mxCell><mxCell id="uc17" value="UC-17 Xem màn hình mô phỏng&lt;br&gt;trải nghiệm trong xe (FR-17)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="270" y="580" width="200" height="80" as="geometry" /></mxCell><mxCell id="uc18" value="UC-18 Ép trạng thái để demo&lt;br&gt;6 case (FR-17)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="270" y="680" width="200" height="80" as="geometry" /></mxCell><mxCell id="uc19" value="UC-19 Ghi phản hồi ngắn&lt;br&gt;(chấp nhận)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="270" y="780" width="200" height="80" as="geometry" /></mxCell><mxCell id="uc20" value="UC-20 Vận hành: local/Docker&lt;br&gt;+ replay / live (FR-14, FR-15)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="270" y="960" width="200" height="80" as="geometry" /></mxCell><mxCell id="uc05" value="UC-05 Phát hiện dấu hiệu&lt;br&gt;từ RGB «include» (FR-4)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="570" y="140" width="200" height="80" as="geometry" /></mxCell><mxCell id="uc06" value="UC-06 Lọc chống cảnh báo sai&lt;br&gt;(FR-2, FR-5) «include»" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="570" y="290" width="200" height="80" as="geometry" /></mxCell><mxCell id="uc07" value="UC-07 Kiểm tra xe đang chạy&lt;br&gt;(CAN-sim) «include» (FR-3)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="570" y="440" width="200" height="80" as="geometry" /></mxCell><mxCell id="uc08" value="UC-08 Ghi nhật ký sự kiện&lt;br&gt;«include» (FR-8)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="570" y="590" width="200" height="80" as="geometry" /></mxCell><mxCell id="uc09" value="UC-09 Giám sát live (FR-7)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="870" y="90" width="200" height="80" as="geometry" /></mxCell><mxCell id="uc10" value="UC-10 Xem nhật ký sự kiện (FR-8)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="870" y="190" width="200" height="80" as="geometry" /></mxCell><mxCell id="uc11" value="UC-11 Xem báo cáo và bảng&lt;br&gt;theo điều kiện (FR-9)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="870" y="290" width="200" height="80" as="geometry" /></mxCell><mxCell id="uc12" value="UC-12 Xem tóm tắt hành vi&lt;br&gt;lái xe — LLM (FR-12)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="870" y="390" width="200" height="80" as="geometry" /></mxCell><mxCell id="uc13" value="UC-13 Xem gợi ý an toàn&lt;br&gt;cá nhân hoá — LLM (FR-13)" style="ellipse;whiteSpace=wrap;h